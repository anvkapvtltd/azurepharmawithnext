# Copy this file to .env.local and fill in the values.
# Gmail: enable 2-Step Verification on the sending account, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=azuremedical01@gmail.com
SMTP_PASS=your-16-char-app-password

# Inbox that receives all website inquiries & career applications
MAIL_TO=azuremedical01@gmail.com

# Public site URL (used for sitemap, robots and social share links)
NEXT_PUBLIC_SITE_URL=https://azurepharma.in
